@* Shared toolbar — identical buttons/markup across every migrated form,
   equivalent to your Forms 6i shared button bar from the subclassed template *@

<div class="form-toolbar" style="margin-bottom: 1rem;">
    <button class="btn btn-primary" @onclick="OnExecuteQuery" disabled="@IsBusy">Execute Query</button>
    <button class="btn btn-info" @onclick="OnNewRecord" disabled="@IsBusy">+ New Record</button>
    <button class="btn btn-success" @onclick="OnSave" disabled="@IsBusy">Save</button>
    <button class="btn btn-secondary" @onclick="OnPrevious" disabled="@IsBusy">◀ Previous</button>
    <button class="btn btn-secondary" @onclick="OnNext" disabled="@IsBusy">Next ▶</button>

    @if (RecordPosition != null)
    {
        <span style="margin-left: 1rem;">@RecordPosition</span>
    }
</div>

@code {
    [Parameter] public EventCallback OnExecuteQuery { get; set; }
    [Parameter] public EventCallback OnNewRecord { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnNext { get; set; }
    [Parameter] public EventCallback OnPrevious { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string? RecordPosition { get; set; }
}
